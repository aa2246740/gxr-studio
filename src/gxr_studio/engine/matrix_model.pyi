from collections.abc import Sequence
from typing import Any

import numpy as np
from numpy.typing import NDArray

Q10: int
COEF_MAX: int
CHROMA_MAX: int
CENTRE: float
ROW_BYTES: int

def decode_coef(u: int) -> int: ...
def encode_coef(v: int) -> int: ...

class MatrixRow:
    coef: NDArray[np.int64]
    tail: tuple[int, ...]
    def __init__(self, coef: Any, tail: Sequence[int]) -> None: ...
    @classmethod
    def from_words(cls, words: Sequence[int]) -> MatrixRow: ...
    @classmethod
    def from_bytes(cls, b: bytes | bytearray) -> MatrixRow: ...
    def words(self) -> list[int]: ...
    def to_bytes(self) -> bytes: ...
    def copy(self, coef: Any = ..., tail: Sequence[int] | None = ...) -> MatrixRow: ...
    @property
    def offsets(self) -> NDArray[np.float64]: ...
    def row_sums(self) -> NDArray[np.int64]: ...
    def violations(self, stock: MatrixRow | None = ...) -> list[str]: ...
    def neutral_preserving(self) -> bool: ...
    def effective(self, vivid_pct: float = ...) -> NDArray[np.float64]: ...
    def apply(self, rgbp: Any, vivid_pct: float = ...) -> tuple[NDArray[np.float64], NDArray[np.complex128]]: ...
    def invert(self, y: Any, c: Any, vivid_pct: float = ...) -> NDArray[np.float64]: ...
    def describe(self) -> dict[str, Any]: ...

class Curve:
    xs: NDArray[np.float64]
    ys: NDArray[np.float64]
    name: str
    def __init__(self, xs: Any, ys: Any, name: str = ...) -> None: ...
    @classmethod
    def from_rows(cls, inputs31: Sequence[float], outputs33: Sequence[float], name: str = ...) -> Curve: ...
    def __call__(self, x: Any) -> NDArray[np.float64]: ...
    def inverse(self, y: Any) -> NDArray[np.float64]: ...

def ycbcr(rgb: Any) -> tuple[NDArray[np.float64], NDArray[np.complex128]]: ...
def rgb_from_ycc(y: Any, c: Any) -> NDArray[np.float64]: ...
def hue_deg(c: Any) -> NDArray[np.float64]: ...
